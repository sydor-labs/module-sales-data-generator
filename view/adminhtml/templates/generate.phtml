            <div class="admin__field-control">
                <input id="sdg-orders" name="<?= /* @noEscape */ Parameters::ORDERS ?>" type="number" min="0"
                       class="admin__control-text validate-digits"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::ORDERS]) ?>"/>
                <div class="admin__field-note"><?= $escaper->escapeHtml(__('Orders to place.')) ?></div>
            </div>
