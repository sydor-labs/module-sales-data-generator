            <div class="admin__field-control">
                <input id="sdg-products" name="<?= /* @noEscape */ Parameters::PRODUCTS ?>" type="number" min="0"
                       class="admin__control-text validate-digits"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::PRODUCTS]) ?>"/>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__('Simple products to create in those categories before any order.')) ?>
                </div>
            </div>
