            <div class="admin__field-control">
                <input id="sdg-from" name="<?= /* @noEscape */ Parameters::FROM ?>" type="date"
                       class="admin__control-text required-entry"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::FROM]) ?>"/>
            </div>
        </div>

        <div class="admin__field _required">
            <label class="admin__field-label" for="sdg-to">
                <span><?= $escaper->escapeHtml(__('To')) ?></span>
            </label>
            <div class="admin__field-control">
                <input id="sdg-to" name="<?= /* @noEscape */ Parameters::TO ?>" type="date"
                       class="admin__control-text required-entry"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::TO]) ?>"/>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__('Days in the store timezone. Times after now are not used.')) ?>
                </div>
            </div>
