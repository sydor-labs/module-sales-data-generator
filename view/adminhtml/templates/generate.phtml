<div class="admin__fieldset-wrapper">
    <div class="admin__fieldset-wrapper-title">
        <strong class="title"><span><?= $escaper->escapeHtml(__('Recent Jobs')) ?></span></strong>
    </div>
    <?php if (!$jobs): ?>
        <p><?= $escaper->escapeHtml(__('No jobs yet.')) ?></p>
    <?php else: ?>
        <p><a href=""><?= $escaper->escapeHtml(__('Refresh')) ?></a></p>
        <table class="data-grid">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Job')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Created')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Progress')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Catalog')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Customers')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Orders')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Order Statuses')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Action')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($jobs as $job): ?>
                <tr>
                    <td>#<?= (int)$job['id'] ?></td>
                    <td><?= $escaper->escapeHtml($job['created_at']) ?></td>
                    <td>
                        <?php if ($job['stalled']): ?>
                            <span class="grid-severity-major">
                                <span><?= $escaper->escapeHtml(__('stalled')) ?></span>
                            </span>
                        <?php elseif ($job['status'] === Job::STATUS_FAILED): ?>
                            <span class="grid-severity-critical">
                                <span><?= $escaper->escapeHtml(__('failed')) ?></span>
                            </span>
                        <?php elseif ($job['status'] === Job::STATUS_DONE): ?>
                            <span class="grid-severity-notice">
                                <span><?= $escaper->escapeHtml(__('done')) ?></span>
                            </span>
                        <?php else: ?>
                            <span class="grid-severity-minor">
                                <span><?= $escaper->escapeHtml(__($job['status'])) ?></span>
                            </span>
                        <?php endif; ?>
                        <?php if ($job['error'] !== ''): ?>
                            <div class="admin__field-error"><?= $escaper->escapeHtml($job['error']) ?></div>
                        <?php endif; ?>
                    </td>
                    <td><?= (int)$job['percent'] ?>%</td>
                    <td><?= $escaper->escapeHtml($job['catalog']) ?></td>
                    <td><?= $escaper->escapeHtml($job['customers']) ?></td>
                    <td>
                        <?= $escaper->escapeHtml($job['orders']) ?>
                        <?php if ($job['failed'] > 0): ?>
                            <br/><?= $escaper->escapeHtml(__('%1 failed', $job['failed'])) ?>
                        <?php endif; ?>
                    </td>
                    <td>
                        <?php foreach ($job['statuses'] as $status => $count): ?>
                            <?= $escaper->escapeHtml($status) ?>: <?= (int)$count ?><br/>
                        <?php endforeach; ?>
                    </td>
                    <td>
                        <?php if ($job['can_resume']): ?>
                            <form action="<?= $escaper->escapeUrl($viewModel->getResumeUrl($job['id'])) ?>"
                                  method="post">
                                <input name="form_key" type="hidden"
                                       value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
                                <button type="submit" class="action-default">
                                    <span><?= $escaper->escapeHtml(__('Resume')) ?></span>
                                </button>
                            </form>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
