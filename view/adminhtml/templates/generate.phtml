            <div class="admin__field-control">
                <select id="sdg-store" name="<?= /* @noEscape */ Parameters::STORE ?>" class="admin__control-select">
                    <?php foreach ($viewModel->getStoreOptions() as $storeId => $label): ?>
                        <option value="<?= (int)$storeId ?>"
                            <?= (int)$values[Parameters::STORE] === $storeId ? 'selected="selected"' : '' ?>>
                            <?= $escaper->escapeHtml($label) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
