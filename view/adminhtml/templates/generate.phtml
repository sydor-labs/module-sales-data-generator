            <div class="admin__field-control">
                <input id="sdg-categories" name="<?= /* @noEscape */ Parameters::CATEGORIES ?>" type="number"
                       min="0" class="admin__control-text validate-digits"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::CATEGORIES]) ?>"/>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__('Categories to create under the store root category first.')) ?>
                </div>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label" for="sdg-products">
                <span><?= $escaper->escapeHtml(__('Products')) ?></span>
