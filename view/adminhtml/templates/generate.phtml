            </label>
            <div class="admin__field-control">
                <input id="sdg-seed" name="<?= /* @noEscape */ Parameters::SEED ?>" type="number" min="0"
                       class="admin__control-text validate-digits"
                       value="<?= $escaper->escapeHtmlAttr($values[Parameters::SEED]) ?>"/>
